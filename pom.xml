<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>mg.niaina.gilbert</groupId>
  <artifactId>hive-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>hive-domain</module>
    <module>hive-algo</module>
    <module>hive-sim</module>
    <module>hive-core</module>
    <module>hive-dashboard</module>
    <module>hive-web</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <servlet.version>6.1.0</servlet.version>
    <websocket.version>2.2.0</websocket.version>
    <junit.version>5.10.2</junit.version>
    <postgresql.version>42.7.3</postgresql.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>${servlet.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>jakarta.websocket</groupId>
        <artifactId>jakarta.websocket-api</artifactId>
        <version>${websocket.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency><groupId>mg.niaina.gilbert</groupId><artifactId>hive-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>mg.niaina.gilbert</groupId><artifactId>hive-algo</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>mg.niaina.gilbert</groupId><artifactId>hive-sim</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>mg.niaina.gilbert</groupId><artifactId>hive-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>mg.niaina.gilbert</groupId><artifactId>hive-dashboard</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version></plugin>
        <plugin><artifactId>maven-war-plugin</artifactId><version>3.4.0</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
